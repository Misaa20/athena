// Athena — Prisma schema
// pgvector is used for AI-driven semantic recommendations.
// After `prisma migrate` or `prisma db push`, run once against your DB:
//   CREATE EXTENSION IF NOT EXISTS vector;

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "driverAdapters"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum ReadingStatus {
  WANT_TO_READ
  READING
  FINISHED
  DNF
}

model User {
  id          String   @id @default(cuid())
  privyId     String?  @unique // Privy DID, set on first authenticated request
  email       String   @unique
  username    String   @unique
  displayName String?
  bio         String?
  avatarUrl   String?
  // AI-generated reading personality (see /api/me/personality).
  readerType     String?
  tasteProfile   String?
  tasteUpdatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries        ReadingEntry[]
  reviews        Review[]
  notes          Note[]
  quotes         Quote[]
  following      Follow[]        @relation("follower")
  followers      Follow[]        @relation("following")
  reviewLikes    ReviewLike[]
  reviewComments ReviewComment[]
  goals          ReadingGoal[]
  shelves        Shelf[]
}

model Book {
  id            String   @id @default(cuid())
  externalId    String?  @unique // Google Books / OpenLibrary id
  isbn13        String?  @unique
  title         String
  subtitle      String?
  authors       String[]
  description   String?
  coverUrl      String?
  pageCount     Int?
  publishedYear Int?
  genres        String[]
  embedding     Unsupported("vector(1536)")?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entries      ReadingEntry[]
  reviews      Review[]
  notes        Note[]
  quotes       Quote[]
  shelfEntries ShelfEntry[]

  @@index([title])
}

model ReadingEntry {
  id        String        @id @default(cuid())
  userId    String
  bookId    String
  status    ReadingStatus @default(WANT_TO_READ)
  rating    Int?          // 1..5
  isFavorite Boolean      @default(false)
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId, status])
  @@index([userId, isFavorite])
}

// User-created shelves on top of the default WANT_TO_READ/READING/FINISHED/DNF
// statuses. A book can sit on multiple custom shelves at once and still have a
// ReadingEntry (or not — a user can curate a recommendation shelf for books
// they haven't read). isPublic controls whether the shelf shows on the
// public profile.
model Shelf {
  id        String   @id @default(cuid())
  userId    String
  name      String
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries ShelfEntry[]

  @@unique([userId, name])
  @@index([userId])
}

model ShelfEntry {
  shelfId   String
  bookId    String
  createdAt DateTime @default(now())

  shelf Shelf @relation(fields: [shelfId], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@id([shelfId, bookId])
  @@index([bookId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  rating    Int      // 1..5
  body      String
  spoiler   Boolean  @default(false)
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  likes    ReviewLike[]
  comments ReviewComment[]

  @@unique([userId, bookId])
  @@index([bookId])
}

model ReviewLike {
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@id([userId, reviewId])
  @@index([reviewId])
}

model ReviewComment {
  id        String   @id @default(cuid())
  userId    String
  reviewId  String
  body      String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

model ReadingGoal {
  userId    String
  year      Int
  target    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, year])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  body      String
  page      Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, bookId])
}

model Quote {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  body      String
  page      Int?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([userId, bookId])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

// The migration adds an ivfflat index for Book.embedding:
//   CREATE INDEX "book_embedding_idx" ON "Book" USING ivfflat ("embedding" vector_cosine_ops);
