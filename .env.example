# PostgreSQL — use Supabase, Neon, Railway, or a local Postgres with the pgvector extension
DATABASE_URL="postgresql://user:password@localhost:5432/athena?schema=public"

# Optional: isolated database for `npm test` integration tests.
# Do not point this at production; tests create and delete data.
TEST_DATABASE_URL=""

# AI provider — pick one (priority: Gemini > Groq > OpenAI > offline stub)
# Free: https://aistudio.google.com/apikey   (Gemini, generous free tier — recommended)
GEMINI_API_KEY=""
# Free: https://console.groq.com             (Groq, very fast Llama 3.3)
GROQ_API_KEY=""
# Paid: https://platform.openai.com
OPENAI_API_KEY=""

# Optional: book metadata
GOOGLE_BOOKS_API_KEY=""

# Optional: tester feedback email used by /feedback
NEXT_PUBLIC_FEEDBACK_EMAIL=""

# Auth — Privy.io
# Get these at https://dashboard.privy.io  (create an app, then App settings → API keys)
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# Optional: enables test-only auth bypass outside production.
# The test suite sets this automatically; never set it in production.
AUTH_TEST_BYPASS_SECRET=""
